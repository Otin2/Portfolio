---
import { Image } from 'astro:assets'
import { site, translations, defaultLang } from '../data.js'
import perfil from '../assets/perfil.webp'

const { about } = translations[defaultLang]
---

<section id="sobre-mi" class="section reveal">
  <div class="container">
    <div class="about__grid">
      <div class="about__text">
        <h2 class="section__title">
          <span class="section__num">01.</span>
          <span data-i18n="about.heading">{about.heading}</span>
        </h2>
        {about.paragraphs.map((p, i) => <p data-i18n={`about.paragraphs.${i}`}>{p}</p>)}
      </div>

      <div class="holo-card-scene">
        <article class="holo-card">
          <div class="holo-card__inner">
            <span class="holo-card__serial" aria-hidden="true">Nº 01 · {site.profile.focus}</span>
            <div class="holo-card__photo">
              {
                site.photo ? (
                  <Image src={perfil} alt={about.card.photoAlt} width={640} loading="lazy" />
                ) : (
                  <svg class="holo-card__placeholder" viewBox="0 0 200 240" aria-hidden="true">
                    <circle cx="100" cy="88" r="40" />
                    <path d="M28 226c9-52 40-72 72-72s63 20 72 72" />
                  </svg>
                )
              }
            </div>
            <div class="holo-card__plate">
              <p class="holo-card__name">{site.name}</p>
              <p class="holo-card__role" data-i18n="about.card.role">{about.card.role}</p>
            </div>
            <div class="holo-card__meta" aria-hidden="true">
              <span>{site.profile.location}</span>
              <span class="holo-card__status">
                <span class="holo-card__status-dot"></span>
                <span data-i18n="about.card.status">{about.card.status}</span>
              </span>
            </div>
            <span class="holo-card__shine" aria-hidden="true"></span>
          </div>
          <div class="holo-card__back" aria-hidden="true">
            <div class="holo-card__emblem">
              <svg viewBox="0 0 200 226" aria-hidden="true">
                <polygon points="100,4 196,60 196,166 100,222 4,166 4,60" />
                <polygon points="100,20 182,68 182,158 100,206 18,158 18,68" />
              </svg>
              <span class="holo-card__back-logo">
                <span class="logo-accent">R</span>Roller<span class="cursor">_</span>
              </span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  import { bindAnimationLifecycle } from '../scripts/visibility.js'

  // Volteo ligado al scroll, inclinación y brillo holografico de la tarjeta
  const scene = document.querySelector<HTMLElement>('.holo-card-scene')
  const card = scene?.querySelector<HTMLElement>('.holo-card')
  const shine = card?.querySelector<HTMLElement>('.holo-card__shine')
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches

  if (scene && card && !reducedMotion) {
    const FLIP_START = 0.68
    const DEAD_ZONE = 0.08
    const mobile = matchMedia('(max-width: 760px)')
    const canHover = matchMedia('(hover: hover)').matches

    let flip = 0
    let rx = 0
    let ry = 0
    let targetFlip = 0
    let targetRx = 0
    let targetRy = 0
    let pointerX = 0
    let pointerY = 0
    let hovering = false
    let active = false
    let raf = 0
    let lastT = 0
    const written: Record<string, string> = {}

    const write = (el: HTMLElement, prop: string, value: string) => {
      const key = el === card ? prop : `shine${prop}`
      if (written[key] === value) return
      written[key] = value
      el.style.setProperty(prop, value)
    }

    const measure = () => {
      const r = scene.getBoundingClientRect()
      const half = (innerHeight + r.height) / 2
      const p = Math.max(-1, Math.min(1, (r.top + r.height / 2 - innerHeight / 2) / half))
      const t = Math.min(1, Math.max(0, (Math.abs(p) - DEAD_ZONE) / (FLIP_START - DEAD_ZONE)))
      targetFlip = Math.sign(p) * t * 180

      if (hovering) {
        const x = Math.min(1, Math.max(0, (pointerX - r.left) / r.width))
        const y = Math.min(1, Math.max(0, (pointerY - r.top) / r.height))
        targetRx = (x - 0.5) * 12
        targetRy = (0.5 - y) * 10
        if (shine) {
          write(shine, '--sx', x.toFixed(3))
          write(shine, '--sy', y.toFixed(3))
        }
      }
    }

    const approach = (value: number, target: number, k: number, dt: number, eps: number) => {
      const next = value + (target - value) * (1 - Math.exp(-k * dt))
      return Math.abs(target - next) < eps ? target : next
    }

    const render = () => {
      write(card, '--flip', `${flip.toFixed(2)}deg`)
      write(card, '--flip-z', `${((Math.abs(flip) / 180) * -17.1).toFixed(2)}deg`)
      write(card, '--rx', `${rx.toFixed(2)}deg`)
      write(card, '--ry', `${ry.toFixed(2)}deg`)
    }

    const tick = (now: number) => {
      const dt = lastT ? Math.min((now - lastT) / 1000, 0.05) : 1 / 60
      lastT = now
      measure()
      const kTilt = hovering ? 20 : 8
      flip = approach(flip, targetFlip, mobile.matches ? 16 : 10, dt, 0.02)
      rx = approach(rx, targetRx, kTilt, dt, 0.01)
      ry = approach(ry, targetRy, kTilt, dt, 0.01)
      render()

      if (flip === targetFlip && rx === targetRx && ry === targetRy) {
        raf = 0
        lastT = 0
        return
      }
      raf = requestAnimationFrame(tick)
    }

    const wake = () => {
      if (active && !raf) raf = requestAnimationFrame(tick)
    }

    const start = () => {
      active = true
      wake()
    }

    const stop = () => {
      active = false
      cancelAnimationFrame(raf)
      raf = 0
      lastT = 0
    }

    addEventListener('scroll', wake, { passive: true })
    addEventListener('resize', wake, { passive: true })

    if (canHover) {
      scene.addEventListener('mousemove', (e) => {
        hovering = true
        pointerX = e.clientX
        pointerY = e.clientY
        wake()
      })

      scene.addEventListener('mouseleave', () => {
        hovering = false
        targetRx = 0
        targetRy = 0
        wake()
      })
    }

    bindAnimationLifecycle(start, stop, scene)
    measure()
    flip = targetFlip
    render()
  }
</script>
